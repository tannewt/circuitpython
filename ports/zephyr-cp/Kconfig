# CircuitPython Zephyr port — application Kconfig
#
# Sources Zephyr's main Kconfig, then adds CircuitPython-specific defaults.
# Boards can override any of these in their boards/<board>.conf file.

osource "$(ZEPHYR_BASE)/Kconfig.zephyr"

# ===== Peripheral defaults — enabled by default, boards can disable =====

config I2C
	default y

config SPI
	default y

config SPI_ASYNC
	default y

config I2S
	default y

config UART_LINE_CTRL
	default y

config ENTROPY_GENERATOR
	default y

# ===== Bluetooth defaults =====

# Use a variable for the chosen name so the comma isn't parsed as an argument separator
DT_BT_HCI_CHOSEN := zephyr,bt-hci

config BT
	default $(dt_chosen_enabled,$(DT_BT_HCI_CHOSEN))

config BT_PERIPHERAL
	default y

config BT_CENTRAL
	default y

config BT_BROADCASTER
	default y

config BT_OBSERVER
	default y

config BT_EXT_ADV
	default y

config BT_DEVICE_APPEARANCE_DYNAMIC
	default y

config BT_DEVICE_NAME_DYNAMIC
	default y

config BT_DEVICE_NAME_MAX
	default 28

config BT_L2CAP_TX_MTU
	default 253

# BT Buffers
config BT_BUF_CMD_TX_SIZE
	default 255

config BT_BUF_EVT_RX_COUNT
	default 16

config BT_BUF_EVT_RX_SIZE
	default 255

config BT_BUF_ACL_TX_COUNT
	default 3

config BT_BUF_ACL_TX_SIZE
	default 251

config BT_BUF_ACL_RX_COUNT_EXTRA
	default 1

config BT_BUF_ACL_RX_SIZE
	default 255

config BT_GATT_DYNAMIC_DB
	default y

config BT_GATT_CLIENT
	default y

config BT_SMP
	default y

config BT_BONDABLE
	default y

config SETTINGS
	default y

config BT_SETTINGS
	default y

config BT_KEYS_OVERWRITE_OLDEST
	default y

# ===== OTA firmware updates over BLE (SMP/MCUmgr) =====
#
# Boards that boot under MCUboot opt in via boards/<vendor>/<board>/sysbuild.conf
# setting CONFIG_BOOTLOADER_MCUBOOT, which sysbuild turns into an app-side
# CONFIG_BOOTLOADER_MCUBOOT. OTA is enabled when the app boots from slot0 under
# MCUboot and has Bluetooth; the app boots with the image upload in slot1.
#
# A slot1_partition must also exist in the final app devicetree: the mcuboot
# fork's partition layout overlays are applied there, so boards.toml-driven
# layouts count. Boards with a single-app layout (e.g. stm32wba65i_dk1,
# siwx917_dk2605a) have no slot1 to stage an upload in, and zephyr_img_mgmt
# fails to build without one, so MCUmgr defaults off for them automatically
# instead of needing a CONFIG_MCUMGR=n override in board.conf.
#
# Gating on BOOTLOADER_MCUBOOT (not just on a slot1_partition existing) keeps
# boards that link the app over the whole flash (e.g. nrf54lm20dk) from letting
# an upload erase the running image that happens to overlap slot1.

DT_HAS_SLOT1 := $(dt_nodelabel_enabled,slot1_partition)

config ZCBOR
	default y if BT && BOOTLOADER_MCUBOOT && $(DT_HAS_SLOT1)

config MCUMGR
	default y if BT && BOOTLOADER_MCUBOOT && $(DT_HAS_SLOT1)

config MCUMGR_TRANSPORT_BT
	default y if BT && BOOTLOADER_MCUBOOT

config MCUMGR_TRANSPORT_BT_REASSEMBLY
	default y if MCUMGR_TRANSPORT_BT

# Request a fast connection interval while an upload is in progress.
config MCUMGR_TRANSPORT_BT_CONN_PARAM_CONTROL
	default y if MCUMGR_TRANSPORT_BT

config IMG_MANAGER
	default y if MCUMGR_TRANSPORT_BT

# IMG_MANAGER ("DFU image manager") depends on STREAM_FLASH, which has no
# default of its own, so enable it with the same gate as IMG_MANAGER.
config STREAM_FLASH
	default y if MCUMGR_TRANSPORT_BT

config MCUMGR_GRP_IMG
	default y if IMG_MANAGER

config MCUMGR_GRP_OS
	default y if MCUMGR_TRANSPORT_BT

# Let clients discover the SMP buffer count/size so they can use optimal
# upload chunking and window sizes (the nRF Connect Device Manager apps do
# this automatically).
config MCUMGR_GRP_OS_MCUMGR_PARAMS
	default y if MCUMGR_GRP_OS

# Fit a full ATT write (the port raises BT_L2CAP_TX_MTU to 515) plus the
# 8-byte MCUmgr BT overhead in each buffer, so one upload packet fills one
# buffer instead of needing reassembly.
config MCUMGR_TRANSPORT_NETBUF_SIZE
	default 528 if MCUMGR_TRANSPORT_BT
